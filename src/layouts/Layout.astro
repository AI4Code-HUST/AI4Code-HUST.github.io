---
import '@phosphor-icons/web/regular';
import '@fontsource/space-grotesk/400.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/inter/600.css';
import '../styles/nocturne.css';
import '../styles/site.css';

interface Props {
  title: string;
  description?: string;
  active: 'home' | 'research' | 'team' | 'publications' | 'join-us' | 'contact';
}

const {
  title,
  description = 'AI4Code is a research group at Hanoi University of Science and Technology applying AI to software engineering and AI systems — code generation, security, and the infrastructure behind large models. We recruit motivated undergraduates.',
  active,
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImageURL = new URL('/favicon.svg', Astro.site);

const NAV_LINKS = [
  { key: 'home', href: '/', label: 'Home' },
  { key: 'research', href: '/research/', label: 'Research' },
  { key: 'team', href: '/team/', label: 'Team' },
  { key: 'publications', href: '/publications/', label: 'Publications' },
  { key: 'join-us', href: '/join-us/', label: 'Join Us' },
  { key: 'contact', href: '/contact/', label: 'Contact' },
] as const;
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href="/favicon.svg" />
  <link rel="canonical" href={canonicalURL} />

  <meta property="og:type" content="website" />
  <meta property="og:site_name" content="AI4Code@HUST Lab" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImageURL} />
  <meta name="twitter:card" content="summary" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageURL} />

  <meta name="generator" content={Astro.generator} />
</head>
<body style="min-height:100vh;">
  <nav class="site-nav" style="position:sticky; top:0; z-index:50; display:flex; align-items:center; gap:28px; padding:16px 40px; background:color-mix(in srgb,var(--color-bg) 72%,transparent); backdrop-filter:blur(14px); border-bottom:1px solid var(--color-divider); flex-wrap:wrap;">
    <a href="/" style="display:inline-flex; align-items:center; gap:11px; text-decoration:none; margin-right:auto;">
      <span style="width:34px; height:34px; border-radius:9px; display:grid; place-items:center; background:linear-gradient(145deg,var(--color-accent-600),var(--color-section)); box-shadow:0 0 0 1px color-mix(in srgb,var(--color-accent) 45%,transparent), 0 4px 16px color-mix(in srgb,var(--color-accent) 40%,transparent);">
        <svg viewBox="0 0 100 100" width="22" height="22" fill="none"><g stroke="var(--color-accent-100)" stroke-width="6" stroke-linecap="round" stroke-linejoin="round"><polyline points="32,26 15,50 32,74"/><polyline points="68,26 85,50 68,74"/></g><g stroke="var(--accent-cyan)" stroke-width="2.4" opacity="0.72"><line x1="43" y1="35" x2="58" y2="42"/><line x1="43" y1="35" x2="58" y2="59"/><line x1="43" y1="50" x2="58" y2="42"/><line x1="43" y1="50" x2="58" y2="59"/><line x1="43" y1="65" x2="58" y2="42"/><line x1="43" y1="65" x2="58" y2="59"/></g><g fill="var(--color-accent-100)"><circle cx="43" cy="35" r="6"/><circle cx="43" cy="50" r="6"/><circle cx="43" cy="65" r="6"/></g><g fill="var(--accent-cyan)"><circle cx="58" cy="42" r="6.4"/><circle cx="58" cy="59" r="6.4"/></g></svg>
      </span>
      <span style="font-family:'Space Grotesk',sans-serif; font-weight:600; font-size:18px; letter-spacing:-0.01em; color:var(--color-text);">AI<span style="color:var(--accent-cyan)">4</span>Code<span class="text-muted" style="font-weight:500;">@HUST</span></span>
    </a>

    <button type="button" class="nav-toggle btn btn-secondary btn-icon" aria-label="Toggle navigation" aria-expanded="false">
      <i class="ph ph-list" style="font-size:18px;"></i>
    </button>

    <div class="nav-links">
      {NAV_LINKS.map((l) => (
        <a href={l.href} class="navlink" aria-current={l.key === active ? 'page' : undefined}>{l.label}</a>
      ))}
    </div>

    <a href="/contact/" class="btn btn-primary cta-primary nav-cta" style="margin-left:6px;">Join us</a>
  </nav>

  <slot />

  <footer style="border-top:1px solid var(--color-divider); padding:32px 40px; display:flex; justify-content:space-between; align-items:center; gap:20px; flex-wrap:wrap; font-size:13px;">
    <span style="display:inline-flex; align-items:center; gap:10px;">
      <span style="width:26px; height:26px; border-radius:7px; display:grid; place-items:center; background:linear-gradient(145deg,var(--color-accent-600),var(--color-section));">
        <svg viewBox="0 0 100 100" width="17" height="17" fill="none"><g stroke="var(--color-accent-100)" stroke-width="6.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="32,26 15,50 32,74"/><polyline points="68,26 85,50 68,74"/></g><g fill="var(--color-accent-100)"><circle cx="43" cy="35" r="6.5"/><circle cx="43" cy="50" r="6.5"/><circle cx="43" cy="65" r="6.5"/></g><g fill="var(--accent-cyan)"><circle cx="58" cy="42" r="7"/><circle cx="58" cy="59" r="7"/></g></svg>
      </span>
      <span class="text-muted">© 2026 AI4Code@HUST Lab · Hanoi University of Science and Technology</span>
    </span>
    <span class="text-muted mono" style="font-size:12px;">School of Information and Communication Technology, HUST</span>
  </footer>

  <script>
    const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
    const nav = document.querySelector<HTMLElement>('.site-nav');
    toggle?.addEventListener('click', () => {
      const open = nav?.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
    });
  </script>
</body>
</html>
