---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Join Us — AI4Code@HUST Lab" active="join-us">
  <main style="max-width:1120px; margin:0 auto; padding:0 40px;">
    <header class="page-header">
      <span class="kick"><i></i>Join the lab</span>
      <h1 class="page-title" style="margin:22px 0 16px; letter-spacing:-0.03em;">Join Us</h1>
      <p class="text-muted" style="font-size:15px; max-width:620px;">We always welcome motivated students who want to work at the intersection of AI and software engineering.</p>
    </header>

    <section class="grid-2" style="margin-bottom:72px;">
      <div class="panel" style="border-radius:var(--radius-lg); background:var(--color-surface); box-shadow:0 0 0 1px var(--color-divider);">
        <span class="kick"><i></i>For prospective students</span>
        <h2 class="subsection-title">Joining the lab</h2>
        <p style="font-size:15px; opacity:0.85;">We welcome HUST undergraduates curious about research at the intersection of AI and software engineering. No prior publications required — motivation and consistency matter most.</p>
        <ul style="font-size:14px; opacity:0.85; padding-left:20px; line-height:1.9;">
          <li>Solid programming and a willingness to read papers.</li>
          <li>Foundations in machine learning or software engineering.</li>
          <li>A few hours per week over at least two semesters.</li>
        </ul>
        <a href="/contact/" class="btn btn-primary cta-primary" style="margin-top:14px;">Apply as a student →</a>
      </div>
      <div class="panel" style="border-radius:var(--radius-lg); background:linear-gradient(145deg,var(--color-section),color-mix(in srgb,var(--color-section) 55%,var(--color-bg))); box-shadow:0 0 0 1px color-mix(in srgb,var(--color-accent) 30%,transparent);">
        <span class="kick"><i></i>What we offer</span>
        <div style="display:flex; flex-direction:column; gap:20px; margin-top:22px;">
          <div style="display:flex; gap:14px;"><i class="ph ph-chalkboard-teacher" style="font-size:22px; color:var(--color-accent-200);"></i><div><div style="font-size:15px; font-family:'Space Grotesk',sans-serif; color:var(--color-accent-100);">Close mentorship</div><p style="font-size:13px; margin:2px 0 0; color:var(--color-accent-100); opacity:0.85;">Weekly 1:1s with senior members and the supervisor — not a queue, a relationship.</p></div></div>
          <div style="display:flex; gap:14px;"><i class="ph ph-file-text" style="font-size:22px; color:var(--color-accent-200);"></i><div><div style="font-size:15px; font-family:'Space Grotesk',sans-serif; color:var(--color-accent-100);">Path to publication</div><p style="font-size:13px; margin:2px 0 0; color:var(--color-accent-100); opacity:0.85;">Our members co-author papers at CORE A/A* conferences and Q1 journals — 21+ and counting.</p></div></div>
          <div style="display:flex; gap:14px;"><i class="ph ph-globe-hemisphere-east" style="font-size:22px; color:var(--color-accent-200);"></i><div><div style="font-size:15px; font-family:'Space Grotesk',sans-serif; color:var(--color-accent-100);">Global network</div><p style="font-size:13px; margin:2px 0 0; color:var(--color-accent-100); opacity:0.85;">Direct ties to labs abroad — alumni referrals into fully-funded PhD programs.</p></div></div>
          <div style="display:flex; gap:14px;"><i class="ph ph-users-three" style="font-size:22px; color:var(--color-accent-200);"></i><div><div style="font-size:15px; font-family:'Space Grotesk',sans-serif; color:var(--color-accent-100);">A real family, not just a lab</div><p style="font-size:13px; margin:2px 0 0; color:var(--color-accent-100); opacity:0.85;">Lunches and dinners with members and alumni, board game sessions — the kind of bonds that outlast graduation.</p></div></div>
        </div>
      </div>
    </section>
  </main>
</Layout>
