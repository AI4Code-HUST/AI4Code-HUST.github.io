---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Research — AI4Code@HUST Lab" active="research">
  <main style="max-width:1120px; margin:0 auto; padding:0 40px;">
    <header class="page-header">
      <span class="kick"><i></i>Research &amp; partners</span>
      <h1 class="page-title" style="margin:22px 0 16px; letter-spacing:-0.03em; max-width:820px;">Research &amp; collaboration</h1>
      <p class="text-muted" style="font-size:16px; max-width:660px;">We apply machine learning across the software lifecycle and to the systems that power AI itself, and we do it together with leading groups worldwide — sending our students on to the best labs and companies.</p>
    </header>

    <section style="padding:8px 0 64px;">
      <span class="kick"><i></i>Research areas</span>
       <div class="grid-3">
        <div class="glow-card panel" style="border-radius:var(--radius-lg); background:linear-gradient(180deg,var(--color-surface),color-mix(in srgb,var(--color-surface) 60%,var(--color-bg))); box-shadow:0 0 0 1px var(--color-divider);">
          <div class="ico-tile" style="margin-bottom:20px;"><i class="ph ph-brackets-curly" style="font-size:26px; color:var(--color-accent);"></i></div>
          <h3 class="card-heading">Code Generation &amp; Analysis</h3>
          <p class="text-muted" style="font-size:14px; margin:0;">Building AI systems that write, understand, and fix software like an expert — helping developers ship secure code faster.</p>
        </div>
        <div class="glow-card panel" style="border-radius:var(--radius-lg); background:linear-gradient(180deg,var(--color-surface),color-mix(in srgb,var(--color-surface) 60%,var(--color-bg))); box-shadow:0 0 0 1px var(--color-divider);">
          <div class="ico-tile" style="margin-bottom:20px;"><i class="ph ph-shield-check" style="font-size:26px; color:var(--color-accent);"></i></div>
          <h3 class="card-heading">Software Security</h3>
          <p class="text-muted" style="font-size:14px; margin:0;">Detecting and predicting vulnerabilities in software and AI systems — helping developers find and fix risks before they ship.</p>
        </div>
        <div class="glow-card panel" style="border-radius:var(--radius-lg); background:linear-gradient(180deg,var(--color-surface),color-mix(in srgb,var(--color-surface) 60%,var(--color-bg))); box-shadow:0 0 0 1px var(--color-divider);">
          <div class="ico-tile" style="margin-bottom:20px;"><i class="ph ph-scales" style="font-size:26px; color:var(--color-accent);"></i></div>
          <h3 class="card-heading">Trustworthy AI Systems</h3>
          <p class="text-muted" style="font-size:14px; margin:0;">Identifying and mitigating risks in AI systems — ensuring reliability, fairness, and safety in real-world deployments.</p>
        </div>
      </div>
    </section>

    <section style="padding:8px 0 80px; border-top:1px solid var(--color-divider);">
      <div style="margin:40px 0 8px;"><span class="kick"><i></i>Collaborators</span></div>
      <h2 class="section-title" style="margin:14px 0 10px; letter-spacing:-0.02em;">Who we work with</h2>
      <p class="text-muted" style="font-size:15px; margin-bottom:28px; max-width:600px;">We publish jointly with software-engineering and AI groups around the world.</p>
      <div class="logo-grid">
        <div class="logo-slot"><img src="/logos/melbourne.png" alt="University of Melbourne" loading="lazy" /></div>
        <div class="logo-slot"><img src="/logos/ncstate.svg" alt="NC State University" loading="lazy" /></div>
        <div class="logo-slot"><img src="/logos/smu.png" alt="Singapore Management University" loading="lazy" /></div>
        <div class="logo-slot"><img src="/logos/adelaide.jpeg" alt="University of Adelaide" loading="lazy" /></div>
        <div class="logo-slot"><img src="/logos/SUTD.png" alt="Singapore University of Technology and Design" loading="lazy" /></div>
      </div>
    </section>
  </main>
</Layout>
