---
import Layout from '../layouts/Layout.astro';
---

<Layout title="AI4Code@HUST — AI for Code, Security & Trustworthy Systems" active="home">
  <div style="overflow:hidden;">

    <!-- HERO -->
    <section style="position:relative; padding:96px 40px 88px;">
      <div style="position:absolute; inset:0; background-image:linear-gradient(var(--color-divider) 1px,transparent 1px),linear-gradient(90deg,var(--color-divider) 1px,transparent 1px); background-size:52px 52px; -webkit-mask-image:radial-gradient(120% 90% at 70% 0%,#000 30%,transparent 72%); mask-image:radial-gradient(120% 90% at 70% 0%,#000 30%,transparent 72%); opacity:.5;"></div>
      <div style="position:absolute; top:-160px; right:-80px; width:620px; height:620px; border-radius:50%; background:radial-gradient(circle,color-mix(in srgb,var(--color-accent) 30%,transparent),transparent 62%); filter:blur(20px); animation:floatglow 14s ease-in-out infinite; pointer-events:none;"></div>
      <div style="position:absolute; top:120px; left:-140px; width:420px; height:420px; border-radius:50%; background:radial-gradient(circle,color-mix(in srgb,var(--color-section-glow) 55%,transparent),transparent 60%); filter:blur(30px); pointer-events:none;"></div>

      <div style="position:relative; max-width:1120px; margin:0 auto;">
        <span class="kick"><i></i>AI4Code Lab · Hanoi University of Science and Technology</span>
        <h1 class="hero-title" style="letter-spacing:-0.035em; margin:26px 0 26px; max-width:960px;">Advancing AI for <span class="grad">Code, Security&nbsp;&amp; Trustworthy Systems</span></h1>
        <p style="font-size:19px; line-height:1.6; opacity:0.82; max-width:640px; margin-bottom:36px;">A research group at Hanoi University of Science and Technology, supervised by Assoc. Prof. Huynh Quyet Thang, working where machine learning and AI meets software engineering.</p>
        <div style="display:flex; gap:14px; flex-wrap:wrap;">
          <a href="/contact/" class="btn btn-primary cta-primary">Join the lab →</a>
          <a href="/publications/" class="btn btn-secondary" style="font-size:15px; padding:13px 24px;">Explore our research</a>
        </div>
      </div>
    </section>

    <!-- RESEARCH AREAS -->
    <section style="max-width:1120px; margin:0 auto; padding:24px 40px 80px;">
      <span class="kick"><i></i>Research areas</span>
      <h2 class="section-title" style="margin:14px 0 32px; letter-spacing:-0.02em;">Three questions we work on</h2>
      <div class="grid-3">
        <div class="glow-card panel" style="border-radius:var(--radius-lg); background:linear-gradient(180deg,var(--color-surface),color-mix(in srgb,var(--color-surface) 60%,var(--color-bg))); box-shadow:0 0 0 1px var(--color-divider);">
          <div class="ico-tile" style="margin-bottom:20px;"><i class="ph ph-brackets-curly" style="font-size:26px; color:var(--color-accent);"></i></div>
          <h3 class="card-heading">Code Generation &amp; Analysis</h3>
          <p class="text-muted" style="font-size:14px; margin:0;">Building AI systems that write, understand, and fix software like an expert — helping developers ship secure code faster.</p>
        </div>
        <div class="glow-card panel" style="border-radius:var(--radius-lg); background:linear-gradient(180deg,var(--color-surface),color-mix(in srgb,var(--color-surface) 60%,var(--color-bg))); box-shadow:0 0 0 1px var(--color-divider);">
          <div class="ico-tile" style="margin-bottom:20px;"><i class="ph ph-shield-check" style="font-size:26px; color:var(--color-accent);"></i></div>
          <h3 class="card-heading">Software Security</h3>
          <p class="text-muted" style="font-size:14px; margin:0;">Detecting and predicting vulnerabilities in software and AI systems — helping developers find and fix risks before they ship.</p>
        </div>
        <div class="glow-card panel" style="border-radius:var(--radius-lg); background:linear-gradient(180deg,var(--color-surface),color-mix(in srgb,var(--color-surface) 60%,var(--color-bg))); box-shadow:0 0 0 1px var(--color-divider);">
          <div class="ico-tile" style="margin-bottom:20px;"><i class="ph ph-scales" style="font-size:26px; color:var(--color-accent);"></i></div>
          <h3 class="card-heading">Trustworthy AI Systems</h3>
          <p class="text-muted" style="font-size:14px; margin:0;">Identifying and mitigating risks in AI systems — ensuring reliability, fairness, and safety in real-world deployments.</p>
        </div>
      </div>
    </section>

    <!-- STAT BAND -->
    <section style="position:relative; padding:64px 40px; background:var(--color-section); background-image:radial-gradient(120% 160% at 12% 0%,var(--color-section-glow),var(--color-section) 60%); overflow:hidden;">
      <div style="position:absolute; inset:0; background-image:linear-gradient(color-mix(in srgb,#fff 6%,transparent) 1px,transparent 1px),linear-gradient(90deg,color-mix(in srgb,#fff 6%,transparent) 1px,transparent 1px); background-size:52px 52px; -webkit-mask-image:radial-gradient(90% 120% at 50% 0%,#000,transparent 75%); mask-image:radial-gradient(90% 120% at 50% 0%,#000,transparent 75%);"></div>
      <div class="grid-stat" style="position:relative; max-width:1120px; margin:0 auto;">
        <div><div style="font-size:52px; font-family:'Space Grotesk',sans-serif; font-weight:600; letter-spacing:-0.03em; color:var(--color-accent-100);">21<span style="color:var(--color-accent-300)">+</span></div><div style="font-size:13px; color:var(--color-accent-100); opacity:0.85; margin-top:4px;">Top-tier papers (A / A* · Q1)</div></div>
        <div><div style="font-size:52px; font-family:'Space Grotesk',sans-serif; font-weight:600; letter-spacing:-0.03em; color:var(--color-accent-100);">6<span style="color:var(--color-accent-300)"></span></div><div style="font-size:13px; color:var(--color-accent-100); opacity:0.85; margin-top:4px;">Supervisors &amp; Mentors</div></div>
        <div><div style="font-size:52px; font-family:'Space Grotesk',sans-serif; font-weight:600; letter-spacing:-0.03em; color:var(--color-accent-100);">16</div><div style="font-size:13px; color:var(--color-accent-100); opacity:0.85; margin-top:4px;">Current lab members</div></div>
        <div><div style="font-size:52px; font-family:'Space Grotesk',sans-serif; font-weight:600; letter-spacing:-0.03em; color:var(--color-accent-100);">8</div><div style="font-size:13px; color:var(--color-accent-100); opacity:0.85; margin-top:4px;">Fully-funded PhD placements abroad</div></div>
      </div>
    </section>

    <!-- NEWS + RECRUITING -->
    <section style="max-width:1120px; margin:0 auto; padding:64px 40px;">
      <div class="grid-2" style="align-items:stretch;">
        <div class="panel" style="border-radius:var(--radius-lg); background:var(--color-surface); box-shadow:0 0 0 1px var(--color-divider);">
          <span class="kick"><i></i>Latest news</span>
          <div style="display:flex; flex-direction:column; gap:20px; margin-top:22px;">
            <div style="display:grid; grid-template-columns:76px 1fr; gap:16px;"><span class="mono text-muted" style="font-size:12px;">JUL 26</span><p style="margin:0; font-size:14px;">Congrats Chinh on receiving a fully-funded PhD scholarship from Nanyang Technological University.</p></div>
            <div style="display:grid; grid-template-columns:76px 1fr; gap:16px;"><span class="mono text-muted" style="font-size:12px;">JUL 26</span><p style="margin:0; font-size:14px;">Congrats Quoc-Hung and Thanh to be awarded TCSE Distinguished Paper Award at ICSME 2026 for their work on the security (backdoor defense) of code language models.</p></div>
            <div style="display:grid; grid-template-columns:76px 1fr; gap:16px;"><span class="mono text-muted" style="font-size:12px;">MAY 26</span><p style="margin:0; font-size:14px;">Congrats Au-Phong to be awarded the Rising Scholar Fellowship from Singapore Management University.</p></div>
            <div style="display:grid; grid-template-columns:76px 1fr; gap:16px;"><span class="mono text-muted" style="font-size:12px;">APRIL 26</span><p style="margin:0; font-size:14px;">Congrats Thanh on earning his PhD from the University of Melbourne and joining the Singapore University of Technology and Design as an Assistant Professor.</p></div>
            <div style="display:grid; grid-template-columns:76px 1fr; gap:16px;"><span class="mono text-muted" style="font-size:12px;">FEB 26</span><p style="margin:0; font-size:14px;">Congrats Manh on joining The University of Sydney as a fully-funded PhD Student.</p></div>
          </div>
        </div>
        <div class="glow-card panel" style="border-radius:var(--radius-lg); background:linear-gradient(145deg,var(--color-section),color-mix(in srgb,var(--color-section) 55%,var(--color-bg))); box-shadow:0 0 0 1px color-mix(in srgb,var(--color-accent) 30%,transparent); display:flex; flex-direction:column; justify-content:center;">
          <h3 class="subsection-title">We are recruiting.</h3>
          <p style="font-size:15px; opacity:0.85; margin-bottom:26px; color:var(--color-accent-100);">We welcome motivated HUST undergraduates and guide you from your first research idea to a published paper, a research mindset, and a career — with alumni now at top companies and PhD programs abroad.</p>
          <a href="/contact/" class="btn btn-primary cta-primary" style="align-self:flex-start;">Introduce yourself →</a>
        </div>
      </div>
    </section>

    <!-- PLACEMENTS -->
    <section style="max-width:1120px; margin:0 auto; padding:64px 40px 16px;">
      <span class="kick"><i></i>Alumni destinations</span>
      <h2 class="section-title" style="margin:14px 0 10px; letter-spacing:-0.02em;">Where our students go</h2>
      <p class="text-muted" style="font-size:15px; margin-bottom:26px; max-width:560px;">Alumni continue to PhD programs at leading institutions worldwide.</p>
      <div class="logo-grid">
        <div class="logo-slot"><img src="/logos/melbourne.png" alt="University of Melbourne" loading="lazy" /></div>
        <div class="logo-slot"><img src="/logos/smu.png" alt="Singapore Management University" loading="lazy" /></div>
        <div class="logo-slot"><img src="/logos/ncstate.svg" alt="NC State University" loading="lazy" /></div>
        <div class="logo-slot"><img src="/logos/sydney.svg" alt="University of Sydney" loading="lazy" /></div>
        <div class="logo-slot"><img src="/logos/SUTD.png" alt="Singapore University of Technology and Design" loading="lazy" /></div>
        <div class="logo-slot"><img src="/logos/ntu.png" alt="Nanyang Technological University" loading="lazy" /></div>
      </div>
    </section>

  </div>
</Layout>
