---
import Layout from '../layouts/Layout.astro';
---

<Layout title="Contact — AI4Code@HUST Lab" active="contact">
  <main style="max-width:1120px; margin:0 auto; padding:0 40px;">
    <header class="page-header">
      <span class="kick"><i></i>Get in touch</span>
      <h1 class="page-title" style="margin:22px 0 16px; letter-spacing:-0.03em; max-width:780px;">Contact us</h1>
      <p class="text-muted" style="font-size:16px; max-width:620px;">Questions, collaboration proposals, media inquiries, or anything else — reach us via email or the form below. Looking to join as a student? See <a href="/join-us/">how to join the lab</a> first.</p>
    </header>

    <section class="grid-contact" style="padding:16px 0 72px;">
      <div>
        <div style="display:flex; flex-direction:column; gap:24px;">
          <div style="display:flex; gap:16px;"><div class="ico-tile sm"><i class="ph ph-map-pin" style="font-size:22px; color:var(--color-accent);"></i></div><div><div style="font-size:15px; font-family:'Space Grotesk',sans-serif;">Address</div><p class="text-muted" style="font-size:14px; margin:4px 0 0;">School of Information and Communication Technology, Hanoi University of Science and Technology<br>No. 1 Dai Co Viet, Hai Ba Trung, Hanoi, Vietnam</p></div></div>
          <div style="display:flex; gap:16px;"><div class="ico-tile sm"><i class="ph ph-buildings" style="font-size:22px; color:var(--color-accent);"></i></div><div><div style="font-size:15px; font-family:'Space Grotesk',sans-serif;">Supervisors</div><p class="text-muted" style="font-size:14px; margin:4px 0 0;">Assoc. Prof. Huynh Quyet Thang — Principal Supervisor<br>Asst. Prof. Thanh Le Cong — Co-Supervisor, Singapore University of Technology and Design</p></div></div>
          <div style="display:flex; gap:16px; align-items:center;"><div class="ico-tile sm"><i class="ph ph-envelope-simple" style="font-size:22px; color:var(--color-accent);"></i></div><div><div style="font-size:15px; font-family:'Space Grotesk',sans-serif;">Email</div><p style="font-size:14px; margin:4px 0 0;"><a href="mailto:thang.huynhquyet@hust.edu.vn">thang.huynhquyet@hust.edu.vn</a></p><p style="font-size:14px; margin:4px 0 0;"><a href="mailto:thanhlc@ieee.org">thanhlc@ieee.org</a></p></div></div>
        </div>
        <div style="margin-top:32px; border-radius:var(--radius-lg); overflow:hidden; box-shadow:0 0 0 1px var(--color-divider);">
          <iframe
            src="https://www.google.com/maps?q=School+of+Information+and+Communication+Technology,+Hanoi+University+of+Science+and+Technology,+1+Dai+Co+Viet,+Hai+Ba+Trung,+Hanoi,+Vietnam&output=embed"
            width="100%"
            height="220"
            style="border:0; display:block;"
            loading="lazy"
            referrerpolicy="no-referrer-when-downgrade"
            title="AI4Code Lab location"
          ></iframe>
          <a href="https://maps.app.goo.gl/GN7sL491WMqKFYm36" target="_blank" rel="noopener noreferrer" style="display:flex; align-items:center; gap:8px; padding:12px 16px; font-size:13px; background:var(--color-surface); text-decoration:none; color:inherit;">
            <i class="ph ph-map-trifold" style="font-size:16px; color:var(--color-accent);"></i> Open in Google Maps
          </a>
        </div>
      </div>

      <form action="https://formspree.io/f/mqergyep" method="POST" class="panel" style="background:var(--color-surface); border-radius:var(--radius-lg); box-shadow:0 0 0 1px var(--color-divider);">
        <h3 class="subsection-title">Send us a message</h3>
        <div class="grid-2" style="gap:16px; margin-bottom:16px;">
          <div class="field"><label for="cf-name">Full name</label><input class="input" id="cf-name" type="text" name="name" placeholder="Nguyen Van A" required></div>
          <div class="field"><label for="cf-email">Email</label><input class="input" id="cf-email" type="email" name="email" placeholder="you@example.com" required></div>
        </div>
        <div class="field" style="margin-bottom:16px;"><label for="cf-role">I am a…</label><input class="input" id="cf-role" type="text" name="role" placeholder="HUST undergraduate / collaborator / other"></div>
        <div class="field" style="margin-bottom:20px;"><label for="cf-message">Message</label><textarea class="input" id="cf-message" name="message" placeholder="Tell us about your interests and background." required></textarea></div>
        <input type="hidden" name="_subject" value="New message from AI4Code@HUST contact form">
        <input type="text" name="_gotcha" style="display:none" tabindex="-1" autocomplete="off" aria-hidden="true">
        <button type="submit" class="btn btn-primary cta-primary btn-block">Send message →</button>
      </form>
    </section>
  </main>
</Layout>
